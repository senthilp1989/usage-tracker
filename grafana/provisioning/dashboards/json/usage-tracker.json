{
  "id": null,
  "title": "Usage Tracker",
  "uid": "usage-tracker",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "username",
        "type": "query",
        "label": "Email",
        "datasource": { "type": "postgres", "uid": "usage-tracker-pg" },
        "query": "SELECT DISTINCT user_email FROM usage_reports ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Users Reporting",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "usage-tracker-pg" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(DISTINCT user_email) AS value FROM usage_reports WHERE report_date BETWEEN $__timeFrom()::date AND $__timeTo()::date AND user_email IN ($username)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Test Cases Created",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "usage-tracker-pg" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(test_cases_created), 0) AS value FROM usage_reports WHERE report_date BETWEEN $__timeFrom()::date AND $__timeTo()::date AND user_email IN ($username)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Test Cases Executed",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "usage-tracker-pg" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(test_cases_executed), 0) AS value FROM usage_reports WHERE report_date BETWEEN $__timeFrom()::date AND $__timeTo()::date AND user_email IN ($username)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Documents Generated",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "postgres", "uid": "usage-tracker-pg" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(documents_generated), 0) AS value FROM usage_reports WHERE report_date BETWEEN $__timeFrom()::date AND $__timeTo()::date AND user_email IN ($username)"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Usage Reports",
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "usage-tracker-pg" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT user_email AS \"Email\", test_cases_created AS \"Test Cases Created\", test_cases_executed AS \"Test Cases Executed\", documents_generated AS \"Documents Generated\", report_date AS \"Date\", reported_at AS \"Last Updated\" FROM usage_reports WHERE report_date BETWEEN $__timeFrom()::date AND $__timeTo()::date AND user_email IN ($username) ORDER BY report_date DESC, user_email"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Date", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Date" }, "properties": [{ "id": "unit", "value": "date" }] },
          { "matcher": { "id": "byName", "options": "Last Updated" }, "properties": [{ "id": "unit", "value": "dateTimeAsIso" }] }
        ]
      }
    }
  ]
}
